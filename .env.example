# Chariot Realty — Coolify deployment variables
# Set these in the Coolify dashboard for this application.
# Do NOT commit real secrets to the repository.

# ---- Build-time (Set in Coolify "Build Environment Variables") ----
# The admin desk (client-side) talks to the Chariot API, not to these routes.
NEXT_PUBLIC_API_URL=https://api.chariotrealty.in
# Only needed if the browser ever talks to Supabase directly (optional today).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Runtime (Set in Coolify "Runtime Environment Variables") ----
# Supabase project location (same project for auth, leads, inventory, storage).
SUPABASE_URL=
# Server-only role key (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Supabase anon key (used server-side by auth helpers as a fallback).
SUPABASE_ANON_KEY=

# Which Supabase accounts may sign in to /admin (comma-separated, lowercase).
SUPABASE_ADMIN_EMAILS=
# Fallback alias accepted by the admin allow-list.
CHARIOT_OWNER_EMAIL=

# Password reset email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chariot Realty <onboarding@resend.dev>

# Server-side admin fallback when no bearer token is present.
ADMIN_DASHBOARD_KEY=

# Lead automation (Composio Gmail so the owner is emailed on new enquiries).
# Enabled only when COMPOSIO_AUTOMATION_ENABLED=true.
COMPOSIO_API_KEY=
COMPOSIO_AUTOMATION_ENABLED=false
COMPOSIO_USER_ID=chariotrealty-owner

# WhatsMeow ingestion gateway (used by the local /api/whatsapp routes).
CHARIOT_WHATSAPP_INGESTOR_URL=
CHARIOT_WHATSAPP_INTERNAL_TOKEN=
CHARIOT_WHATSAPP_BROKER_ID=chariot-realty
CHARIOT_WHATSAPP_SELF_JID=

# WhatsMeow ingestor service (services/whatsmeow-ingestor). Inbound WhatsApp
# messages are stored raw in public.chariot_whatsapp_messages (30-day retention).
# EXTRACTION IS ON DEMAND: leave the trigger URL empty and inline extraction off,
# so nothing is ever converted into a listing until Kapil asks the assistant.
CHARIOT_API_URL=https://api.chariotrealty.in
CHARIOT_WHATSAPP_WEBHOOK_URL=
CHARIOT_EXTRACTION_TRIGGER_URL=
PROPAI_TRIGGER_EXTRACTION_INLINE=false
# A self-chat-only broker drops every message except the owner's self-chat. Listing
# the broker id here still stores its WhatsApp GROUP messages in the raw store so
# the assistant can search them on demand. Group traffic is never forwarded.
PROPAI_SELF_CHAT_ONLY_BROKERS=
CHARIOT_WHATSAPP_INGEST_GROUPS=chariot-realty

# Chariot assistant (used by the /api/agent/chat route). Self-contained — talks to
# Sarvam AI and searches Chariot's own listings/requirements/leads. No PropAI needed.
SARVAM_API_KEY=